# Server-side secrets for the HealthO Pro marketing site.
# This file is git-ignored and blocked from web access (see .htaccess).
# It is read only by PHP on the server (plans.php) and never exposed to the browser.

HEALTHO_API_URL=https://healtho.pro/saas/api/plans
HEALTHO_API_KEY=Tzp7vNNXVB7iYsAmYQeEzIfAYVe4Q8fFDCHEOPbyy9vxiCcVot9pvOOuVvZ0iAfP
HEALTHO_MODULES_URL=https://healtho.pro/saas/api/settings/modules

# Currency symbol used on pricing cards
HEALTHO_CURRENCY=₹

# Cache lifetime for the proxied plans response, in seconds
HEALTHO_PLANS_CACHE_TTL=600

# CCX Partners (channel partner directory + certificate verification)
