# Server-side secrets for the HealthO Pro marketing site.
# This file is git-ignored and blocked from web access (see .htaccess).
# It is read only by PHP on the server (plans.php) and never exposed to the browser.

HEALTHO_API_URL=https://healtho.pro/saas/api/plans
HEALTHO_API_KEY=Tzp7vNNXVB7iYsAmYQeEzIfAYVe4Q8fFDCHEOPbyy9vxiCcVot9pvOOuVvZ0iAfP
HEALTHO_MODULES_URL=https://healtho.pro/saas/api/settings/modules

# Currency symbol used on pricing cards
HEALTHO_CURRENCY=₹

# Cache lifetime for the proxied plans response, in seconds
HEALTHO_PLANS_CACHE_TTL=600

# CCX Partners (channel partner directory + certificate verification)
# API key comes from HealthO Pro admin: CCX Partners -> Settings -> Website API Key
CCX_PARTNERS_API_URL=https://healtho.pro/ccx_partners/ccx_partners_api
CCX_PARTNERS_API_KEY=ddeed0a2ad027256705b61d33b79d6d09acb34ed5fd41ca1a111572a65cc80eb
CCX_PARTNERS_CACHE_TTL=600

# Careers needs no configuration: the openings come from the CRM's keyless
# embed endpoint (see partials/careers-data.php and CAREERS_EMBED_BASE in
# partials/site.php). There is no careers API key.

# Pro Leads CRM (website lead forms → CRM, with lead source / UTM)
PRO_LEADS_API_KEY=2bd225fb954a4a18ad0606b3ed7bbffb07fc44cf195b1b7849bf352fb68ab1f2

# Omni Messaging Contacts (launch page subscribers → Omni Contacts, server-side only)
# Key comes from HealthO Pro admin: Omni Messaging → Contacts → API
OMNI_CONTACTS_API_URL=https://healtho.pro/sms_wa_email/contacts_api/
OMNI_CONTACTS_API_KEY=omc_fe0868e96605dadac4ca74cf6c866a41ef6ea1a8fb6a8378
# Signs the "subscribed" cookie that unlocks the launch reveal
LAUNCH_COOKIE_SECRET=5cd372828a837ce2cb765bf9dd8dc6a18facdc0eb5e2e604
# Optional override of the reveal moment (ISO 8601) — leave empty in production
