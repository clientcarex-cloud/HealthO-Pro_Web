Options +FollowSymLinks -MultiViews
RewriteEngine On

# Block direct web access to dotfiles and secrets (.env, .git, etc.)
RewriteRule (^|/)\.(?!well-known) - [F]
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>

# Single job opening: /careers/{slug} -> career.php?j={slug}
# Must precede the extension rules — "careers/senior-engineer.php" does not
# exist, so without this the request would fall through to a 404.
RewriteRule ^careers/([A-Za-z0-9\-]+)/?$ career.php?j=$1 [L,QSA]

# Internally add .html extension if the file exists
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# Internally add .php extension if the file exists
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*)$ $1.php [L]